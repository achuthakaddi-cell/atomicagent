# ============================================================================
# ATOMICAGENT — ENVIRONMENT TEMPLATE
#
# Copy this to .env and fill in your own values:   copy .env.example .env
# NEVER commit .env — it is gitignored for a reason.
# ============================================================================

# --- NETWORK ---
# TestNet for round one of the challenge. MainNet applies to round two.
# Switching networks changes these values only; no code changes are needed.
#
# TestNet:  algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# MainNet:  algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
#
# USDC ASA id — TestNet: 10458941   MainNet: 31566704
ALGO_NETWORK=testnet
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.algonode.cloud
EXPLORER_BASE_URL=https://lora.algokit.io/testnet

# CAIP-2 identifier. Verified against ALGORAND_TESTNET_CAIP2 in @x402-avm/avm 2.6.1
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# --- FACILITATOR (public GoPlausible facilitator, no API key required) ---
FACILITATOR_URL=https://facilitator.goplausible.xyz

# --- PAYMENT ASSET ---
# Default: USDC on Algorand TestNet.
# Fallback: mint your own 6-decimal ASA and put its id here if the USDC
# faucet is unavailable. Nothing else in the codebase needs to change.
PAYMENT_ASSET_ID=10458941
PAYMENT_ASSET_DECIMALS=6
PAYMENT_ASSET_SYMBOL=USDC

# --- PAYEE ADDRESSES ---
# PUBLIC Algorand addresses only. Never put a mnemonic or private key here.
# Generate your own with scripts/gen-accounts.mjs, then fund them on TestNet.
SVC_PRICE_ADDRESS=
SVC_AVAILABILITY_ADDRESS=
SVC_VERIFICATION_ADDRESS=
SUPPLIER_ADDRESS=

# --- SERVICE FEES (atomic units: 10000 = 0.01 USDC at 6 decimals) ---
FEE_PRICE=10000
FEE_AVAILABILITY=10000
FEE_VERIFICATION=10000

# --- PORTS ---
PORT_ORCHESTRATOR=4100
PORT_SERVICE_PRICE=4101
PORT_SERVICE_AVAILABILITY=4102
PORT_SERVICE_VERIFICATION=4103

# --- SERVICE URLS (how the orchestrator reaches each microservice) ---
URL_SERVICE_PRICE=http://localhost:4101
URL_SERVICE_AVAILABILITY=http://localhost:4102
URL_SERVICE_VERIFICATION=http://localhost:4103

# --- FRONTEND (only VITE_ prefixed variables reach the browser) ---
VITE_ORCHESTRATOR_URL=http://localhost:4100
VITE_EXPLORER_BASE_URL=https://lora.algokit.io/testnet
VITE_ALGO_NETWORK=testnet

# --- SECURITY ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOG_LEVEL=info

# --- CARBON SERVICE (demonstrates pluggable registration) ---
SVC_CARBON_ADDRESS=
PORT_SERVICE_CARBON=4104
URL_SERVICE_CARBON=http://localhost:4104
FEE_CARBON=25000